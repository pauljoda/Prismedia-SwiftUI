 	$(APPLY) $(SRC)/libplacebo/0001-vulkan-utils_gen-fix-for-python-3.14.patch
 	$(APPLY) $(SRC)/libplacebo/0001-shaders-use-glsl100-compatible-dovi-reshape-selector.patch
+	$(APPLY) $(SRC)/libplacebo/0002-prismedia-fix-glsl120-rectangle-sampling.patch
 	$(MOVE)
 
 .libplacebo: libplacebo crossfile.meson .python-venv
